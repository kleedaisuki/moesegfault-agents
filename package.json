{
  "name": "moesegfault-agents-deployment",
  "private": true,
  "type": "module",
  "scripts": {
    "build:worker": "cd crates/agents-worker && worker-build --release",
    "build:dashboard": "npm --prefix apps/dashboard run build",
    "dev": "wrangler dev --env staging",
    "deploy:staging": "wrangler deploy --env staging",
    "deploy:production": "wrangler deploy --env production",
    "test:tooling": "node --test scripts/*.test.mjs",
    "test:worker": "node --test tests/worker/*.test.mjs"
  },
  "devDependencies": {
    "miniflare": "5.20261019.2-beta",
    "openai": "7.43.0",
    "wrangler": "4.152.0"
  },
  "overrides": {
    "miniflare": {
      "undici": "7.30.1"
    }
  }
}
